{
    "name": "@robert.tools/health",
    "version": "1.0.0",
    "description": "provide functions to detect the health of your project",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": "./dist/index.js"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "init": "robi init",
        "release": "robi release",
        "status": "robi status",
        "version": "robi version",
        "verbose": "robi verbose",
        "pub": "npm whoami && npm publish --access public",
        "build": "rm -rf dist && tsc -p tsconfig.build.json",
        "test": "jest --coverage --runInBand --verbose --no-watchman",
        "lint": "eslint .",
        "check": "npm run lint && npm test && npm run build",
        "prepublishOnly": "npm run check"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/robert-tools/health.git"
    },
    "bugs": {
        "url": "https://github.com/robert-tools/health/issues"
    },
    "homepage": "https://github.com/robert-tools/health#readme",
    "keywords": [
        "typescript",
        "node",
        "health",
        "robert.tools"
    ],
    "author": "Robert Willemelis",
    "license": "MIT",
    "engines": {
        "node": ">=22"
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    },
    "devDependencies": {
        "@robert.tools/setup": "^1.3.0",
        "@types/jest": "^29.5.14",
        "@types/node": "^24.0.0",
        "@typescript-eslint/eslint-plugin": "^8.0.0",
        "@typescript-eslint/parser": "^8.0.0",
        "eslint": "^9.0.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.6",
        "jest": "^29.7.0",
        "jest-environment-jsdom": "^29.6.2",
        "ts-jest": "^29.4.0",
        "typescript": "^5.9.0"
    }
}
